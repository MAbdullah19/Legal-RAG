# Copy to .env and fill in. Never commit .env.
# The E0 smoke pipeline needs NONE of these — they are for adopted
# integrations (cloud LLMs/embeddings, backing stores, trackers).

# --- LLM / embedding providers (local-first posture, ADR 0005) ---
# Local is the default; these API keys are only for opt-in bake-off comparisons.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Local OpenAI-compatible endpoint for grounded generation (the default path).
# Ollama serves on :11434/v1; vLLM on :8000/v1; LM Studio on :1234/v1.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# --- Data connectors ---
# Optional CourtListener token (courtlistener.com/help/api) — lifts rate limits
# and unlocks full opinion bodies; anonymous works for small metadata/graph slices.
COURTLISTENER_API_TOKEN=

# --- Backing stores (docker-compose defaults, see infra/) ---
QDRANT_URL=http://localhost:6333
POSTGRES_DSN=postgresql://legalrag:legalrag@localhost:5432/legalrag
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=legalrag
MINIO_SECRET_KEY=legalrag123

# --- Tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Spend guardrails ---
LLM_MONTHLY_USD_CAP=50
