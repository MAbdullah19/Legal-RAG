{"doc_id":"xx/high/2018-220/v1","doc_type":"judgment","jurisdiction":"xx","title":"Karim v. Revenue Board","court":{"court_id":"xx/high","name":"Testland High Court","level":"appellate","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2018 TLR 220","kind":"reporter","normalized":"2018 TLR 220","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem"],"decision_date":"2018-12-01","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_high_2018-220_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Issue","path":["Issue"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"The question is which version of the Limitation Act governs an appeal filed in 2018 in respect of a cause accruing in 2014.","page_span":null}]},{"heading":"Analysis","path":["Analysis"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"The 2016 amendment to the Limitation Act shortened the appeal period but applies prospectively; rights of appeal accrued before the amendment are governed by the earlier text.","page_span":null},{"pid":"p0003","para_no":null,"text":"Accordingly the appellant is entitled to the longer pre-amendment period.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"The appeal is held to be within time under the un-amended Limitation Act.","page_span":null}]}],"citations_out":[{"raw":"Limitation Act 1975 s. 3","kind":"reporter","normalized":"Limitation Act 1975 s. 3","from_para":null,"char_span":null,"target_doc_id":"xx/statute/limitation-act/v1","treatment":null},{"raw":"Limitation (Amendment) Act 2016","kind":"reporter","normalized":"Limitation (Amendment) Act 2016","from_para":null,"char_span":null,"target_doc_id":"xx/statute/limitation-act/v2","treatment":null}],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"xx/statute/limitation-act/v1","doc_type":"statute","jurisdiction":"xx","title":"Limitation Act of Testland (1975)","court":null,"case_numbers":[],"citations_self":[{"raw":"Limitation Act 1975","kind":"statute","normalized":null,"reporter":null,"year":null,"volume":null,"page":null}],"judges":[],"decision_date":null,"language":"en","version":{"version_label":"1975","valid_from":"1975-01-01","valid_to":"2016-06-30","predecessor_doc_id":null},"source":{"source":"fixture","url":"https://courts.testland.example/xx_statute_limitation_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Section 3 — Appeals","path":["Section 3 — Appeals"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"An appeal to the High Court shall be preferred within sixty days of the order appealed against.","page_span":null},{"pid":"p0002","para_no":null,"text":"The Court may admit an appeal after the prescribed period if satisfied that there was sufficient cause for not preferring it within time.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"xx/statute/limitation-act/v2","doc_type":"statute","jurisdiction":"xx","title":"Limitation Act of Testland (as amended 2016)","court":null,"case_numbers":[],"citations_self":[{"raw":"Limitation Act 2016","kind":"statute","normalized":null,"reporter":null,"year":null,"volume":null,"page":null}],"judges":[],"decision_date":null,"language":"en","version":{"version_label":"2016","valid_from":"2016-07-01","valid_to":null,"predecessor_doc_id":"xx/statute/limitation-act/v1"},"source":{"source":"fixture","url":"https://courts.testland.example/xx_statute_limitation_v2","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Section 3 — Appeals (amended)","path":["Section 3 — Appeals (amended)"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"An appeal to the High Court shall be preferred within thirty days of the order appealed against.","page_span":null},{"pid":"p0002","para_no":null,"text":"The Court may condone delay only upon a satisfactory explanation accounting for each day of delay.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
