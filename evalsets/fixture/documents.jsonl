{"doc_id":"xx/apex/2018-050/v1","doc_type":"judgment","jurisdiction":"xx","title":"Ahsan v. State","court":{"court_id":"xx/apex","name":"Supreme Court of Testland","level":"apex","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2018 TLR 50","kind":"reporter","normalized":"2018 TLR 50","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem"],"decision_date":"2018-04-12","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_apex_2018-050_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Facts","path":["Facts"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"The appellant was accused of large-scale financial misappropriation and sought post-arrest bail after prolonged detention.","page_span":null}]},{"heading":"Principles","path":["Principles"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"Bail in economic offences is not to be refused as punishment; the gravity of the alleged fraud is a relevant but not a decisive factor.","page_span":null},{"pid":"p0003","para_no":null,"text":"Where the investigation is complete and the accused is unlikely to abscond or tamper with evidence, continued incarceration serves no purpose and bail should ordinarily follow.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"The petition is allowed and the appellant is admitted to bail subject to sureties.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"xx/high/2019-114/v1","doc_type":"judgment","jurisdiction":"xx","title":"Bano v. Collector","court":{"court_id":"xx/high","name":"Testland High Court","level":"appellate","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2019 TLR 114","kind":"reporter","normalized":"2019 TLR 114","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem"],"decision_date":"2019-09-03","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_high_2019-114_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Facts","path":["Facts"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"The appeal was filed nineteen days beyond the limitation period prescribed by the Limitation Act of Testland, and the appellant sought condonation of the delay.","page_span":null}]},{"heading":"Limitation","path":["Limitation"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"Under the Limitation Act, an appeal to this Court must be filed within thirty days; the Court may condone delay only on proof of sufficient cause explaining every day of the delay.","page_span":null},{"pid":"p0003","para_no":null,"text":"Sufficient cause is to be construed liberally where the party has acted bona fide, but a litigant who is negligent cannot invoke the Court's discretion.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"The explanation being unsatisfactory, condonation is refused and the appeal is dismissed as time-barred.","page_span":null}]}],"citations_out":[{"raw":"Limitation Act s. 3","kind":"reporter","normalized":"Limitation Act s. 3","from_para":null,"char_span":null,"target_doc_id":"xx/statute/limitation-act/v1","treatment":null}],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"xx/apex/1990-003/v1","doc_type":"judgment","jurisdiction":"xx","title":"Foundational Carriage Co. v. Meridian Mills","court":{"court_id":"xx/apex","name":"Supreme Court of Testland","level":"apex","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"1990 TLR 3","kind":"reporter","normalized":"1990 TLR 3","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice R. Meridian"],"decision_date":"1990-01-20","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_apex_1990-003_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Rule of Remoteness","path":["Rule of Remoteness"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"Damages for breach of contract are recoverable only for loss that arises naturally from the breach, or that both parties could reasonably have contemplated at the time of contracting.","page_span":null},{"pid":"p0002","para_no":null,"text":"Loss flowing from special circumstances not communicated to the defaulting party is too remote to be recovered.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0003","para_no":null,"text":"The carrier was not liable for the extraordinary loss of profits that had not been made known to it.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"xx/high/2015-201/v1","doc_type":"judgment","jurisdiction":"xx","title":"Zephyr Textiles v. Nasir","court":{"court_id":"xx/high","name":"Testland High Court","level":"appellate","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2015 TLR 201","kind":"reporter","normalized":"2015 TLR 201","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem"],"decision_date":"2015-06-15","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_high_2015-201_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Facts","path":["Facts"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"Zephyr Textiles claimed lost profits after the defendant's late delivery of dyeing chemicals disrupted an export order.","page_span":null}]},{"heading":"Analysis","path":["Analysis"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"Applying the rule of remoteness, ordinary lost profits are recoverable, but the Court held that even uncommunicated export penalties were recoverable where the defendant ought to have known of the export trade.","page_span":null},{"pid":"p0003","para_no":null,"text":"This extension of contemplation to matters merely capable of being known marks the outer boundary of recoverable damages.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"Damages including the export penalty were awarded to the plaintiff.","page_span":null}]}],"citations_out":[{"raw":"1990 TLR 3","kind":"reporter","normalized":"1990 TLR 3","from_para":null,"char_span":null,"target_doc_id":"xx/apex/1990-003/v1","treatment":"relied_on"}],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"xx/apex/2020-077/v1","doc_type":"judgment","jurisdiction":"xx","title":"Rahim Trading v. Delta Mills","court":{"court_id":"xx/apex","name":"Supreme Court of Testland","level":"apex","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2020 TLR 77","kind":"reporter","normalized":"2020 TLR 77","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem","Justice S. Noor"],"decision_date":"2020-11-02","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_apex_2020-077_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Introduction","path":["Introduction"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"This appeal, reported as 2020 TLR 77, concerns the correct measure of damages for remoteness following a breach of a supply contract.","page_span":null}]},{"heading":"Discussion","path":["Discussion"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"We reaffirm the foundational rule that only losses arising naturally, or within the reasonable contemplation of the parties, are recoverable.","page_span":null},{"pid":"p0003","para_no":null,"text":"The broader test suggested in Zephyr Textiles, extending liability to matters a defendant merely ought to have known, states the principle too widely and is not approved.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"The award of the uncommunicated export penalty is set aside; ordinary damages are affirmed.","page_span":null}]}],"citations_out":[{"raw":"1990 TLR 3","kind":"reporter","normalized":"1990 TLR 3","from_para":null,"char_span":null,"target_doc_id":"xx/apex/1990-003/v1","treatment":"followed"},{"raw":"2015 TLR 201","kind":"reporter","normalized":"2015 TLR 201","from_para":null,"char_span":null,"target_doc_id":"xx/high/2015-201/v1","treatment":"distinguished"}],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":"cluster-rahim-2020","warnings":[]}}
{"doc_id":"xx/apex/2021-090/v1","doc_type":"judgment","jurisdiction":"xx","title":"Delta Mills v. Rahim Trading (Review)","court":{"court_id":"xx/apex","name":"Supreme Court of Testland","level":"apex","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2021 TLR 90","kind":"reporter","normalized":"2021 TLR 90","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem"],"decision_date":"2021-03-18","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_apex_2021-090_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Scope","path":["Scope"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"On review the Court settles the status of the wider contemplation test after Rahim Trading.","page_span":null}]},{"heading":"Holding","path":["Holding"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"To the extent that Zephyr Textiles held a defendant liable for losses it merely ought to have known of, that decision is overruled.","page_span":null},{"pid":"p0003","para_no":null,"text":"The foundational two-limb rule of remoteness is followed as the sole test.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"The review is disposed of; Zephyr Textiles is overruled on the point of remoteness.","page_span":null}]}],"citations_out":[{"raw":"2015 TLR 201","kind":"reporter","normalized":"2015 TLR 201","from_para":null,"char_span":null,"target_doc_id":"xx/high/2015-201/v1","treatment":"overruled"},{"raw":"1990 TLR 3","kind":"reporter","normalized":"1990 TLR 3","from_para":null,"char_span":null,"target_doc_id":"xx/apex/1990-003/v1","treatment":"followed"}],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
