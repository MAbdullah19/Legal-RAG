{"doc_id":"xx/high/2016-410/v1","doc_type":"judgment","jurisdiction":"xx","title":"Farah v. Testland Handwriting Board","court":{"court_id":"xx/high","name":"Testland High Court","level":"appellate","jurisdiction":"xx"},"case_numbers":[],"citations_self":[{"raw":"2016 TLR 410","kind":"reporter","normalized":"2016 TLR 410","reporter":null,"year":null,"volume":null,"page":null}],"judges":["Justice A. Kareem"],"decision_date":"2016-08-22","language":"en","version":null,"source":{"source":"fixture","url":"https://courts.testland.example/xx_high_2016-410_v1","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"synthetic public record (fixture)"},"body":[{"heading":"Facts","path":["Facts"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"Th3 appe11ant challenged the admissibi1ity of expert handwriting evidence led to prove a disputed signature on a promissory note.","page_span":null}]},{"heading":"Admissibility","path":["Admissibility"],"paragraphs":[{"pid":"p0002","para_no":null,"text":"Opinion evidence of a handwriting expert is admissible but is weak evidence that must be corroborated before it can sustain a conviction or a civil finding.","page_span":null},{"pid":"p0003","para_no":null,"text":"The court must itself compare the disputed and admitted signatures rather than surrender its judgment to the expert.","page_span":null}]},{"heading":"Held","path":["Held"],"paragraphs":[{"pid":"p0004","para_no":null,"text":"The finding based solely on uncorroborated handwriting opinion is set aside.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":true,"ocr_confidence":0.62,"parse_score":0.55,"dedup_cluster_id":null,"warnings":["low OCR confidence","character substitutions detected"]}}
