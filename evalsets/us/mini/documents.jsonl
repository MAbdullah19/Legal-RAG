{"doc_id":"us/scotus/410-us-113/v1","doc_type":"judgment","jurisdiction":"us","title":"Roe v. Wade","court":{"court_id":"us/scotus","name":"Supreme Court of the United States","level":"apex","jurisdiction":"us"},"case_numbers":[],"citations_self":[{"raw":"410 U.S. 113","kind":"reporter","normalized":"410 U.S. 113","reporter":null,"year":null,"volume":null,"page":null}],"judges":[],"decision_date":"1973-01-01","language":"en","version":null,"source":{"source":"us/sample","url":"https://www.courtlistener.com/410-us-113/","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"US judicial opinion (public record); text paraphrased for fixture"},"body":[{"heading":"Opinion","path":["Opinion"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"This Court in Griswold v. Connecticut, 381 U.S. 479, recognized a constitutional right to privacy.","page_span":null},{"pid":"p0002","para_no":null,"text":"Relying on Griswold, we hold that this right is broad enough to encompass the decision at issue.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
{"doc_id":"us/scotus/505-us-833/v1","doc_type":"judgment","jurisdiction":"us","title":"Planned Parenthood v. Casey","court":{"court_id":"us/scotus","name":"Supreme Court of the United States","level":"apex","jurisdiction":"us"},"case_numbers":[],"citations_self":[{"raw":"505 U.S. 833","kind":"reporter","normalized":"505 U.S. 833","reporter":null,"year":null,"volume":null,"page":null}],"judges":[],"decision_date":"1992-01-01","language":"en","version":null,"source":{"source":"us/sample","url":"https://www.courtlistener.com/505-us-833/","fetched_at":null,"checksum":null,"license_basis":"public_record","license_note":"US judicial opinion (public record); text paraphrased for fixture"},"body":[{"heading":"Opinion","path":["Opinion"],"paragraphs":[{"pid":"p0001","para_no":null,"text":"We reaffirm the essential holding of Roe v. Wade, 410 U.S. 113, while adopting an undue-burden standard.","page_span":null},{"pid":"p0002","para_no":null,"text":"Adhering to Roe, the Court declines to overturn its central rule.","page_span":null}]}],"citations_out":[],"quality":{"is_ocr":false,"ocr_confidence":null,"parse_score":null,"dedup_cluster_id":null,"warnings":[]}}
